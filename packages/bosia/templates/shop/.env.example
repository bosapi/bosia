DATABASE_URL=sqlite://./data/app.db

SESSION_SECRET=change-me-in-production
# The response cache tells users apart by these cookies. Keep bosia_session
# (the sign-in cookie) here, or one user's page can be served to another.
CACHE_KEYS=session,sid,auth,token,jwt,Authorization,bosia_session

STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

PUBLIC_BASE_URL=
